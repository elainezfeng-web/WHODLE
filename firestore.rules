rules_version = '2';

// WHODLE visitor counter
//
// Model: one document per browser at visitors/{visitorId}, where visitorId is
// a random 32-character hex string that counter.js keeps in localStorage. The
// number shown on the site is a server-side count over that collection, so
// nobody can inflate it by writing to a counter field.
//
// There is no authentication. These rules validate what a row looks like, not
// who wrote it, so a script can still add rows. (Anonymous auth had the same
// hole: it can create unlimited accounts.) The id pattern and the single
// server timestamp just keep the collection well-formed and stop a client from
// reusing ids that could ever mean something else.
//
// Deploy with:  firebase deploy --only firestore:rules
// Or paste this file into Firebase Console -> Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    match /visitors/{visitorId} {

      // The public count query needs read access to the collection. It works
      // signed out too - that's the point of not using auth. The documents
      // hold nothing but a timestamp.
      allow read: if true;

      // Anyone may add an anonymous row: an id of the shape counter.js
      // generates, exactly one field, and a server-generated timestamp.
      allow create: if visitorId.matches('^[0-9a-f]{32}$')
                    && request.resource.data.keys().hasOnly(['firstSeen'])
                    && request.resource.data.firstSeen == request.time;

      // No edits, no deletes: a visitor row is permanent, so the count only grows.
      allow update, delete: if false;
    }

    // Everything else in the database stays private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
